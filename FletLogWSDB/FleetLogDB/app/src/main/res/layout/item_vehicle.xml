<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!--
            REQUISITO RÚBRICA: ImageView que muestra la imagen Base64 decodificada a Bitmap.
            En getView() del adaptador se usa ImageUtils.base64ToBitmap()
        -->
        <ImageView
            android:id="@+id/ivVehicleImage"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_car"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/tvBrandModel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Toyota Hilux"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#1A237E"
            app:layout_constraintStart_toEndOf="@id/ivVehicleImage"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvPlate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Placa: ABC-1234"
            android:textSize="13sp"
            android:textColor="#555555"
            android:layout_marginTop="4dp"
            app:layout_constraintStart_toStartOf="@id/tvBrandModel"
            app:layout_constraintTop_toBottomOf="@id/tvBrandModel" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Activo"
            android:textSize="12sp"
            android:textColor="#2E7D32"
            android:layout_marginTop="4dp"
            app:layout_constraintStart_toStartOf="@id/tvBrandModel"
            app:layout_constraintTop_toBottomOf="@id/tvPlate" />

        <TextView
            android:id="@+id/tvYear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2023"
            android:textSize="13sp"
            android:textColor="#777777"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>